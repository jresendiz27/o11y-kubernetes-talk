// NOT RECOMMENDED FOR PRODUCTION
livedebugging {
	enabled = true
}

// Traces: OTLP -> Tempo
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		traces = [otelcol.exporter.otlphttp.tempo.input]
	}
}

otelcol.exporter.otlphttp "tempo" {
	client {
		endpoint = "http://tempo.monitoring.svc.cluster.local:4318"
	}
}

// Logs: Kubernetes pods -> Loki
discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_component"]
		target_label  = "component"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_owner"]
		target_label  = "owner"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_business_unit"]
		target_label  = "business_unit"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_name",
			"__meta_kubernetes_pod_label_k8s_app",
			"__meta_kubernetes_pod_label_app",
		]
		separator = ""
		regex     = ""
		action    = "drop"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component"]
		regex         = "canary"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_controller_name"]
		regex         = "loki-canary"
		action        = "drop"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.process.k8s.receiver]
}

loki.process "k8s" {
	stage.labels {
		values = {
			namespace = "namespace",
			pod       = "pod",
			container = "container",
			job       = "job",
		}
	}

	stage.drop {
		expression = "Health check completed"
	}

	stage.drop {
		source = "level"
		value  = "unknown_level"
	}

	stage.drop {
		expression = "canary-push"
	}

	// --- PII Filtering: Pattern-based masking ---
	// Scans the ENTIRE log line (JSON or not) for PII patterns and masks them.
	// This catches PII regardless of field names or log format.
	// Email: matches user@domain.tld anywhere in the log line
	stage.replace {
		expression = "[\\w\\-\\.]+@([\\w-]+\\.)+[\\w-]{2,}"
		replace    = "[EMAIL_REDACTED]"
	}

	stage.replace {
		expression = "(\\+\\d{1,3}\\s*)?\\(?\\d{3}\\)?[\\s\\-]?\\d{3}[\\s\\-]?\\d{4}"
		replace    = "[PHONE_REDACTED]"
	}
	// --- PII Filtering: Field dropping (specific known fields) ---
	// Safety net: redact known sensitive fields by name, even if pattern regex misses them
	stage.replace {
		expression = `("user_address":")[^"]*(")`
		replace    = "${1}[REDACTED]${2}"
	}

	forward_to = [loki.write.default.receiver]
}

loki.source.kubernetes_events "cluster_events" {
	job_name   = "integrations/kubernetes/eventhandler"
	log_format = "logfmt"
	forward_to = [
		loki.process.cluster_events.receiver,
	]
}

loki.process "cluster_events" {
	forward_to = [loki.write.default.receiver]

	stage.static_labels {
		values = {
			cluster = "minikube",
		}
	}

	stage.labels {
		values = {
			kubernetes_cluster_events = "job",
		}
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
	}
}
